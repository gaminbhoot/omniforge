# ==============================================================================
# ⚡ OmniForge Environment Configuration
# ==============================================================================

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# LLM Provider Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.meta.ai
ANTHROPIC_MODEL=muse-spark-1.2-contributor[1m]

# Optional Alternative Providers
OPENAI_API_KEY=

# TrueForge Harness
TRUEFORGE_API_KEY=
TRUEFORGE_API_URL=http://localhost:8790

# Sandbox
SANDBOX_IMAGE=omniforge-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1

# Qodo PR Reviews
QODO_ENABLED=true
