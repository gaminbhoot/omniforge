# ==============================================================================
# ⚡ OmniForge Environment Configuration
# ==============================================================================

# Server Settings
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Anthropic / Custom Endpoint Configuration
ANTHROPIC_MODEL=muse-spark-1.2-contributor[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=muse-spark-1.2-contributor[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=muse-spark-1.2-contributor[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-spark-1.2-contributor[1m]
CLAUDE_CODE_SUBAGENT_MODEL=muse-spark-1.2-contributor[1m]
ENABLE_TOOL_SEARCH=true
ANTHROPIC_BASE_URL=https://api.meta.ai
ANTHROPIC_AUTH_TOKEN=

# TrueForge Harness (Provided for Hackathon)
TRUEFORGE_API_KEY=
TRUEFORGE_API_URL=http://localhost:8790

# Sandbox Environment Configuration
SANDBOX_IMAGE=omniforge-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1

# Qodo Review Integration
QODO_ENABLED=true
