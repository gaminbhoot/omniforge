# OmniForge Environment — copy to .env and fill
# ──────────────────────────────────────────
# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# LLM — bring your own key (used by TrueForge orchestrator)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# TrueForge (to be provided at kickoff Aug 24)
TRUEFORGE_API_KEY=
TRUEFORGE_API_URL=

# Databases (DataForge) — optional, mocked if empty
DATABASE_URL=postgresql://user:pass@localhost:5432/omniforge
CLICKHOUSE_URL=http://localhost:8123
DUCKDB_PATH=:memory:

# Sandbox
SANDBOX_IMAGE=omniforge-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1

# Qodo
QODO_ENABLED=true
