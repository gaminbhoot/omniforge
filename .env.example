# OmniForge server configuration

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# HITL policy engine — auto-reject pending approvals after this window (ms)
APPROVAL_TTL_MS=300000

# Sandbox execution (Docker container omniforge-sandbox)
# SANDBOX_DOCKER=false only in development to skip Docker entirely.
SANDBOX_DOCKER=true
# Explicit opt-in for local (non-Docker) code execution when the sandbox
# container is unavailable. Leave unset to fail closed (recommended).
# SANDBOX_ALLOW_LOCAL=true

# API auth (SA-04, optional): when set, all mutating API calls require this
# value as the X-API-Key header. The cockpit reads VITE_OMNIFORGE_TOKEN.
# OMNIFORGE_TOKEN=

# TrueForge harness (optional — enables the harness bridge endpoints)
TRUEFORGE_API_URL=http://localhost:8790
# TRUEFORGE_API_KEY=

# LLM provider keys are configured in the TrueForge harness, not in this server.
